{
  "catalog_version": "3.6",
  "last_updated": "2026-10-05",
  "description": "Executable model catalog: every entry in 'models' can be instantiated dynamically (import_path + params) so several models can be trained and compared in parallel with a generic runner. 'interfaces' defines how to call fit/predict for each API type. 'tooling' covers support libraries (tuning, interpretability, tracking) that are not models and do not compete in the comparison.",
  "interfaces": {
    "sklearn_estimator": {
      "instantiate": "cls(**default_params)",
      "fit": "estimator.fit(X_train, y_train)",
      "predict": "estimator.predict(X_test)",
      "predict_proba": "estimator.predict_proba(X_test)  # if supports_predict_proba",
      "parallel_safe": true,
      "notes": "uniform scikit-learn API; xgboost, lightgbm, catboost and surprise also implement it through their sklearn wrapper",
      "fit_params_notes": "class_balance = list of candidates (none / scale_pos_weight / is_unbalance) -> the runner compares them by calibrated log-loss with cross-fitting on the validation rows; fit_params.early_stopping_rounds + eval_metric -> early stopping on the validation set (LightGBM only)",
      "brand_notes": "brand_feature='categorical' -> the runner adds brandId as a categorical feature (outside feature selection); only for models that accept categorical features (LightGBM)"
    },
    "statsmodels_timeseries": {
      "instantiate": "cls(endog, **default_params)",
      "fit": "fitted = model.fit()",
      "predict": "fitted.forecast(steps) | fitted.predict(start, end)",
      "parallel_safe": true,
      "notes": "the constructor takes the series directly, not separate X/y"
    },
    "pmdarima_functional": {
      "instantiate": "n/a (it is a function, not a class)",
      "fit": "model = pmdarima.auto_arima(y, **default_params)",
      "predict": "model.predict(n_periods)",
      "parallel_safe": true
    },
    "prophet": {
      "instantiate": "cls(**default_params)",
      "fit": "model.fit(df)  # df with columns 'ds','y'",
      "predict": "model.predict(future_df)",
      "parallel_safe": true
    },
    "pytorch_custom": {
      "instantiate": "factory_fn(**default_params) -> nn.Module  (defined in the project, not in the catalog)",
      "fit": "own training loop (there is no generic .fit())",
      "predict": "model(x)",
      "parallel_safe": false,
      "notes": "needs a network architecture defined in code; the catalog only references the 'factory', import_path + params is not enough"
    },
    "huggingface_pretrained": {
      "instantiate": "cls.from_pretrained(pretrained_model_name, **default_params)",
      "fit": "transformers.Trainer(...).train()",
      "predict": "model(**inputs)",
      "parallel_safe": false,
      "notes": "large models; running several at once competes for GPU/RAM, better sequential or with queues"
    },
    "stable_baselines3": {
      "instantiate": "cls('MlpPolicy', env, **default_params)",
      "fit": "model.learn(total_timesteps)",
      "predict": "model.predict(obs)",
      "parallel_safe": false,
      "notes": "needs an environment (env) as well as data; comparing 5-6 algorithms in parallel is feasible on CPU if the env is light"
    },
    "pymc_factory": {
      "instantiate": "factory_fn(data, **default_params) -> pm.Model  (defined in the project)",
      "fit": "with model: idata = pm.sample()",
      "predict": "pm.sample_posterior_predictive(idata)",
      "parallel_safe": false,
      "notes": "MCMC is expensive; running several Bayesian models in parallel can saturate the CPU quickly"
    },
    "lifelines_survival": {
      "instantiate": "cls(**default_params)",
      "fit": "fitter.fit(df, duration_col, event_col, cluster_col=None)  # df = features + duration + event",
      "predict": "fitter.predict_survival_function(X) | fitter.predict_median(X) | fitter.predict_partial_hazard(X)",
      "parallel_safe": true,
      "notes": "survival models: fit takes a single DataFrame with the duration and the event indicator, not separate X/y; evaluated with the concordance index",
      "brand_notes": "brand_strata=true -> Cox stratified by brandId: one baseline curve per brand, shared covariate effects"
    }
  },
