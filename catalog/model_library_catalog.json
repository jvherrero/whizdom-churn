{
  "catalog_version": "2.7",
  "last_updated": "2026-10-05",
  "description": "Catálogo ejecutable de modelos: cada entrada en 'models' es instanciable dinámicamente (import_path + params) para poder entrenar y comparar varios modelos en paralelo con un runner genérico. 'interfaces' define cómo llamar fit/predict según el tipo de API. 'tooling' cubre librerías de soporte (tuning, interpretabilidad, tracking) que no son modelos y no compiten en la comparación.",
  "interfaces": {
    "sklearn_estimator": {
      "instantiate": "cls(**default_params)",
      "fit": "estimator.fit(X_train, y_train)",
      "predict": "estimator.predict(X_test)",
      "predict_proba": "estimator.predict_proba(X_test)  # si supports_predict_proba",
      "parallel_safe": true,
      "notes": "API uniforme de scikit-learn; también la implementan xgboost, lightgbm, catboost y surprise en modo wrapper sklearn",
      "fit_params_notes": "class_balance = lista de candidatos (none / scale_pos_weight / is_unbalance) -> el runner los compara por log-loss calibrada con cross-fitting sobre validación; fit_params.early_stopping_rounds + eval_metric -> early stopping sobre el conjunto de validación (solo LightGBM)",
      "brand_notes": "brand_feature='categorical' -> el runner añade brandId como variable categórica (fuera de la selección); solo para modelos que aceptan categóricas (LightGBM)"
    },
    "statsmodels_timeseries": {
      "instantiate": "cls(endog, **default_params)",
      "fit": "fitted = model.fit()",
      "predict": "fitted.forecast(steps) | fitted.predict(start, end)",
      "parallel_safe": true,
      "notes": "constructor recibe la serie directamente, no X/y separados"
    },
    "pmdarima_functional": {
      "instantiate": "n/a (es una función, no una clase)",
      "fit": "model = pmdarima.auto_arima(y, **default_params)",
      "predict": "model.predict(n_periods)",
      "parallel_safe": true
    },
    "prophet": {
      "instantiate": "cls(**default_params)",
      "fit": "model.fit(df)  # df con columnas 'ds','y'",
      "predict": "model.predict(future_df)",
      "parallel_safe": true
    },
    "pytorch_custom": {
      "instantiate": "factory_fn(**default_params) -> nn.Module  (definida en el proyecto, no en el catálogo)",
      "fit": "training loop propio (no hay .fit() genérico)",
      "predict": "model(x)",
      "parallel_safe": false,
      "notes": "requiere arquitectura de red definida en código; el catálogo solo referencia el 'factory', no basta con import_path + params"
    },
    "huggingface_pretrained": {
      "instantiate": "cls.from_pretrained(pretrained_model_name, **default_params)",
      "fit": "transformers.Trainer(...).train()",
      "predict": "model(**inputs)",
      "parallel_safe": false,
      "notes": "modelos grandes; correr varios a la vez compite por GPU/RAM, mejor secuencial o con colas"
    },
    "stable_baselines3": {
      "instantiate": "cls('MlpPolicy', env, **default_params)",
      "fit": "model.learn(total_timesteps)",
      "predict": "model.predict(obs)",
      "parallel_safe": false,
      "notes": "necesita un entorno (env) además de datos; comparar 5-6 algoritmos en paralelo es viable en CPU si el env es liviano"
    },
    "pymc_factory": {
      "instantiate": "factory_fn(data, **default_params) -> pm.Model  (definida en el proyecto)",
      "fit": "with model: idata = pm.sample()",
      "predict": "pm.sample_posterior_predictive(idata)",
      "parallel_safe": false,
      "notes": "MCMC es costoso; correr varios modelos bayesianos en paralelo puede saturar CPU rápido"
    },
    "lifelines_survival": {
      "instantiate": "cls(**default_params)",
      "fit": "fitter.fit(df, duration_col, event_col, cluster_col=None)  # df = features + duración + evento",
      "predict": "fitter.predict_survival_function(X) | fitter.predict_median(X) | fitter.predict_partial_hazard(X)",
      "parallel_safe": true,
      "notes": "modelos de supervivencia: el fit recibe un único DataFrame con la duración y el indicador de evento, no X/y separados; se evalúa con concordance index",
      "brand_notes": "brand_strata=true -> Cox estratificado por brandId: una curva base por marca y efectos de las variables comunes"
    }
  },
