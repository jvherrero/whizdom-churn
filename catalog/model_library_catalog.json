      "pip_package": "lightgbm",
      "import_path": "lightgbm.LGBMClassifier",
      "interface": "sklearn_estimator",
      "instantiation": "direct",
      "default_params": {
        "objective": "binary",
        "metric": "binary_logloss",
        "n_estimators": 2000,
        "learning_rate": 0.05,
        "num_leaves": 63,
        "colsample_bytree": 0.8,
        "subsample": 0.8,
        "subsample_freq": 1,
        "min_child_samples": 100,
        "random_state": 42,
        "verbose": -1
      },
      "param_grid": {
        "n_estimators": [
          100,
          200
        ],
        "num_leaves": [
          31,
          63
        ],
        "learning_rate": [
          0.05,
          0.1
        ]
      },
      "requires_scaling": false,
      "supports_predict_proba": true,
      "parallelizable": true,
      "class_balance": [
        "none",
        "scale_pos_weight",
        "is_unbalance"
      ],
      "fit_params": {
        "early_stopping_rounds": 100,
        "eval_metric": [
          "auc"
        ],
        "first_metric_only": true,
        "notes": "early stopping on validation AUC only (patience 100); binary_logloss (the model metric) is still recorded, it is the Optuna objective"
      },
      "notes": "binary log-loss; none (no weights), scale_pos_weight = negatives/positives of train and is_unbalance=true are compared by log-loss after calibration, not by AUC (weights distort the probabilities); the preferred one is scale_pos_weight (class_balance_preferred), useful for brands with a very small churn class: another option only wins if it improves that log-loss by more than class_balance_min_gain; calibration corrects the probability distortion the weights introduce; n_estimators is a ceiling, early stopping on validation (AUC and log-loss) picks the real tree count",
      "calibration": {
        "methods": [
          "isotonic",
          "platt"
        ],
        "fit_on": "valid",
        "choose_by": "test_ece",
        "notes": "isotonic and Platt are fitted on the validation rows (per brand, all brands as the fallback); the one with the lowest ECE on the test month is kept"
      },
      "class_balance_selection": "calibrated_log_loss",
      "class_balance_min_gain": 0.002,
      "brand_feature": "categorical",
      "class_balance_preferred": "scale_pos_weight",
      "search": {
        "library": "optuna",
        "sampler": "TPE (Bayesian)",
        "n_trials": 100,
        "objective": "validation log-loss (with early stopping)",
        "pruner": {
          "type": "median",
          "n_startup_trials": 10,
          "n_warmup_steps": 20
        },
        "seed": 42,
        "fixed_params": {
          "subsample_freq": 1
        },
        "space": {
          "num_leaves": {
            "type": "int",
            "low": 15,
            "high": 255
          },
          "learning_rate": {
            "type": "float",
            "low": 0.01,
            "high": 0.2,
            "log": true
          },
          "min_child_samples": {
            "type": "int",
            "low": 20,
            "high": 500
          },
          "colsample_bytree": {
            "type": "float",
            "low": 0.5,
            "high": 1.0,
            "alias": "feature_fraction"
          },
          "subsample": {
            "type": "float",
            "low": 0.5,
            "high": 1.0,
            "alias": "bagging_fraction"
          },
          "reg_alpha": {
            "type": "float",
            "low": 1e-08,
            "high": 10.0,
            "log": true,
            "alias": "lambda_l1"
          },
          "reg_lambda": {
            "type": "float",
            "low": 1e-08,
            "high": 10.0,
            "log": true,
            "alias": "lambda_l2"
          },
          "max_depth": {
            "type": "int",
            "low": 4,
            "high": 10
          }
        },
        "refit": "the best trial is refit on train with the tree count of its early stopping"
      },
      "regularisation_check": {
        "max_gap": 0.03,
        "max_valid_auc_loss": 0.002,
        "max_rounds": 6,
        "steps": {
          "min_child_samples": {
            "factor": 1.5,
            "max": 500
          },
          "reg_lambda": {
            "factor": 3.0,
            "start_at_least": 0.1,
            "max": 100.0
          },
          "num_leaves": {
            "factor": 0.75,
            "min": 15
          }
        },
        "notes": "if the train - validation AUC gap is over max_gap, min_child_samples and lambda_l2 (reg_lambda) go up and num_leaves goes down, one round at a time, until the gap closes; a round that loses more than max_valid_auc_loss of validation AUC is rejected and the previous one kept"
      },
      "final_pruning": {
        "max_valid_auc_loss": 0.002,
        "notes": "the Stage 2 permutation-importance rule applied again to the final (tuned, regularised) model: the smallest set within 0.002 validation AUC of the full model; the model is refit on that set, which is what serving uses"
      },
      "inference_budget": {
        "benchmark_players": 100000,
        "max_seconds_full_run": 600,
        "population_players": null,
        "container_slowdown": 1.0,
        "safety_margin": 0.8,
        "notes": "scoring time is measured per 100k players; the full population is population_players or, if null, the players of the dataset's latest cutoff; container_slowdown scales the time measured here to the serving container (1.0 = same machine, set it once measured there); if the projection goes over max_seconds_full_run, the tree count is capped (with safety_margin) and the model refit"
      },
      "default_params_notes": "optimisation step 1, sane defaults: colsample_bytree = feature_fraction, subsample = bagging_fraction (subsample_freq=1 turns bagging on); n_estimators is a ceiling"
    },
