# Jupyter
.ipynb_checkpoints/

# DuckDB spill-to-disk temp storage (created in the cwd when a query
# exceeds memory_limit, can reach tens of GB, safe to delete once the
# connection that created it is closed)
.tmp/
*.duckdb.tmp/

# MLflow local tracking
mlruns/
mlartifacts/
mlflow.db

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl

# Secrets / environment
.env
*.env
*.tfvars

# OS / editor / Windows-WSL noise
.DS_Store
Thumbs.db
*:Zone.Identifier
~$*


# Project-specific
_admin_logs
